PORT = 8585
HOST = "127.0.0.1"
BASE_DIR = os.path.dirname(os.path.abspath(__file__))

# 1. API 키 보안: 소스코드에 하드코딩하지 않고 .env 파일 및 환경변수에서만 안전하게 로드
ENV_PATH = os.path.join(BASE_DIR, ".env")
NEBIUS_API_KEY = os.environ.get("NEBIUS_API_KEY", "")
NEBIUS_BASE_URL = os.environ.get("NEBIUS_BASE_URL", "https://api.tokenfactory.nebius.com/v1")
NVIDIA_MODEL = "nvidia/Nemotron-3-Ultra-550b-a55b"

if os.path.exists(ENV_PATH):
    try:
        with open(ENV_PATH, "r", encoding="utf-8") as ef:
            for line in ef:
                line = line.strip()
                if line.startswith("NEBIUS_API_KEY="):
                    NEBIUS_API_KEY = line.split("=", 1)[1].strip().strip('"').strip("'")
                elif line.startswith("NEBIUS_BASE_URL="):
                    NEBIUS_BASE_URL = line.split("=", 1)[1].strip().strip('"').strip("'")
    except Exception as e:
        print(f"[알림] .env 로드 예외: {e}")

USE_LIVE_API = bool(NEBIUS_API_KEY)


def call_nebius_nemotron(receipt_type, condition, pain_regions, vas, steps_drop, arousal_min):
    """NVIDIA Nemotron 3 Ultra 550B 실시간 임상-재정 인과 추론 (Nebius Token Factory)"""
    t0 = time.time()

    if receipt_type == "KR":
        system_prompt = (
            "당신은 환자가 병원 원무과와 정중하게 소통할 수 있도록 돕는 '의료비 확인 질의서 참고 초안' 작성 비서(NVIDIA Nemotron 3 Ultra 550B)입니다. "
            "당신은 의료 진단을 내리거나 위법을 판정하는 기관이 아니며, 오직 환자가 제공한 정보에 기반하여 병원에 확인을 요청할 수 있는 정중한 질문 초안을 작성합니다. "
            "환자의 기저질환(상병), 주관적 통증(VAS, 부위), 스마트워치 객관적 활동성 수치를 병원 영수증 내역과 대조하여, "
            "기저질환의 급성 경과에 비추어 병원 청구 항목 중 산정 근거의 재확인이 필요한 부분을 객관적으로 짚어주는 문의서 초안을 작성합니다. "
            "반드시 순수 JSON 형식으로 응답하세요: "
            '{"audit_header": "병원 원무과 진료비 확인 질의서 초안", "target_item": "비급여 도수치료 (120,000원)", "reasoning": "기저질환 경과 및 활동성 데이터 대비 청구 항목 소명 필요성 분석", "inquiry_letter": "원무과 제출용 정중한 문의서 초안"}'
        )
        user_prompt = (
            f"환자 등록 정보:\n"
            f"- 기저질환(상병): {condition}\n"
            f"- 마킹 통증 부위: {pain_regions}\n"
            f"- 통증 강도(VAS): {vas} / 10\n"
            f"- 당일 보행수: {steps_drop} 급감 (1,200보)\n"
            f"- 야간 수면 각성: {arousal_min}분 (통증성 수면 분절)\n\n"
            f"병원 청구 영수증 내역:\n"
            f"- 의료기관: 종합병원 정형외과\n"
            f"- 청구 항목: 급성 요추부 기본 물리치료 및 비급여 도수치료(120,000원) 동시 산정\n"
            f"- 총 수납액: 135,400원\n\n"
            f"작성 요청:\n"
            f"환자의 기저질환({condition})과 당일 급성 통증(VAS {vas}) 및 보행량 급감 수치에 비추어, 비급여 도수치료의 동시 산정 사유와 급여 기준 적용 여부에 대해 병원 원무과에 정중히 확인 및 소명을 요청할 수 있는 '진료비 확인 질의서 초안'을 작성하세요."
        )
    else:
        system_prompt = (
            "You are a patient advocacy billing communication assistant powered by NVIDIA Nemotron 3 Ultra (550B) on Nebius Token Factory. "
            "You are NOT a medical doctor or a judge, and you do not make definitive legal or medical fraud rulings. "
            "Your role is clinical-financial causal reasoning: synthesizing the patient's documented pre-existing condition, subjective pain telemetry (VAS, mapped regions), and objective wearable functional impairment (daily step drop, nocturnal awakenings) against hospital itemized billing codes (CPT). "
            "Your objective is to generate a polite, evidence-backed inquiry draft for the patient to present to the hospital billing department, requesting clarification on Medical Decision Making (MDM) complexity justification for CPT 99284 (Level 4 ED visit) given non-emergent vital stability, and inquiring about federal No Surprises Act balance billing protections for the unexpected out-of-network CPT 72148 reading fee ($920). "
            "Respond strictly in valid JSON: "
            '{"audit_header": "Hospital Billing Clarification Inquiry Draft", "target_item": "CPT 72148 Out-of-Network Lumbar Reading Fee ($920.00)", "reasoning": "Detailed clinical-financial causal reasoning referencing pre-existing condition, functional drop, and coding guidelines", "inquiry_letter": "Polite inquiry letter draft for hospital billing department"}'
        )
        user_prompt = (
            f"Patient Health Telemetry:\n"
            f"- Pre-existing Condition: {condition}\n"
            f"- Mapped Pain Regions: {pain_regions}\n"
            f"- Subjective Pain Scale (VAS): {vas} / 10\n"
            f"- Mobility Drop: {steps_drop} drop to 1,200 steps (acute functional impairment)\n"
            f"- Sleep Disruption: {arousal_min} min nocturnal arousal from pain\n\n"
            f"Hospital Itemized Bill:\n"
            f"- Facility: St. Jude Medical Center - Emergency Department\n"
            f"- Total Billed: $3,450.00\n"
            f"- CPT 99284 (Emergency Dept Visit, Level 4): $1,850.00\n"
            f"- CPT 72148 (Lumbar Spine Imaging / MRI Reading Fee, Out-of-Network Specialist): $920.00\n"
            f"- Facility Supplies & Meds: $680.00\n\n"
            f"Reasoning & Inquiry Drafting Task:\n"
            f"1. Cross-reference the patient's pre-existing {condition}, acute pain exacerbation, and 73% mobility drop against the billing codes.\n"
            f"2. Formulate polite, evidence-based clarification questions: (a) Ask the hospital for clinical MDM documentation supporting Level 4 ED visit vs Level 3, considering vital signs were stable, and (b) Inquire whether the unexpected $920 out-of-network specialist fee is protected under the federal No Surprises Act balance billing regulations for emergency facilities.\n"
            f"3. Draft a respectful, professional inquiry letter for the patient to deliver to hospital billing."
        )

    payload = {
        "model": NVIDIA_MODEL,
        "messages": [
            {"role": "system", "content": system_prompt},
            {"role": "user", "content": user_prompt}
        ],
        "temperature": 0.1,
        "max_tokens": 1200
    }

    req = urllib.request.Request(
        f"{NEBIUS_BASE_URL}/chat/completions",
        data=json.dumps(payload).encode("utf-8"),
        headers={
            "Authorization": f"Bearer {NEBIUS_API_KEY}",
            "Content-Type": "application/json",
            "User-Agent": "PainFree-NebiusAgent/1.0"
        }
    )

    with urllib.request.urlopen(req, timeout=30) as res:
        res_data = json.loads(res.read().decode("utf-8"))
        raw_text = res_data["choices"][0]["message"]["content"]
        elapsed = round((time.time() - t0) * 1000)

        # JSON 추출
        try:
            if "```json" in raw_text:
                json_str = raw_text.split("```json")[1].split("```")[0].strip()
            elif "{" in raw_text and "}" in raw_text:
                start = raw_text.find("{")
                end = raw_text.rfind("}") + 1
                json_str = raw_text[start:end]
            else:
                json_str = raw_text
            parsed = json.loads(json_str, strict=False)
            parsed["live_latency_ms"] = elapsed
            parsed["model"] = f"{NVIDIA_MODEL} (Nebius Live)"
            parsed["is_live"] = True
            parsed["status"] = "success"
            return parsed
        except Exception:
            header_m = re.search(r'"audit_header"\s*:\s*"([^"]+)"', raw_text)
            target_m = re.search(r'"target_item"\s*:\s*"([^"]+)"', raw_text)
            reason_m = re.search(r'"reasoning"\s*:\s*"((?:[^"\\]|\\.)*)"', raw_text, re.DOTALL)
            letter_m = re.search(r'"inquiry_letter"\s*:\s*"((?:[^"\\]|\\.)*)"', raw_text, re.DOTALL)

            header_val = header_m.group(1) if header_m else ("병원 원무과 진료비 확인 질의서 초안" if receipt_type == "KR" else "Hospital Billing Clarification Inquiry Draft")
            target_val = target_m.group(1) if target_m else ("비급여 도수치료 (120,000원)" if receipt_type == "KR" else "CPT 72148 Out-of-Network Lumbar Reading Fee ($920.00)")
            reason_val = reason_m.group(1).replace("\\n", "\n").replace('\\"', '"') if reason_m else ("기저질환 경과 및 활동성 데이터 대비 청구 항목 소명 필요성이 분석되었습니다.")
            letter_val = letter_m.group(1).replace("\\n", "\n").replace('\\"', '"') if letter_m else ("원무과 제출용 질의서 초안 작성이 완료되었습니다.")

            return {
                "status": "success",
                "model": f"{NVIDIA_MODEL} (Nebius Live)",
                "live_latency_ms": elapsed,
                "is_live": True,
                "audit_header": header_val,
                "target_item": target_val,
                "reasoning": reason_val,
                "inquiry_letter": letter_val
            }


class HackathonHandler(http.server.SimpleHTTPRequestHandler):
    ALLOWED_STATIC = {
        "": "index.html",
        "index.html": "index.html",
        "body.png": "body.png",
        "body_front.svg": "body_front.svg",
        "body_back.svg": "body_back.svg",
        "favicon.ico": "favicon.ico"
    }

    def translate_path(self, path):
        """철저한 보안 격리: 오직 화이트리스트에 등록된 정적 자산만 서빙하고 .env, .py 등은 접근 원천 차단"""
        parsed = urllib.parse.urlparse(path).path
        clean = parsed.lstrip("/").replace("\\", "/")
        if ".." in clean:
            return os.path.join(BASE_DIR, "__forbidden_path_traversal__")

        if clean in self.ALLOWED_STATIC:
            return os.path.join(BASE_DIR, self.ALLOWED_STATIC[clean])

        return os.path.join(BASE_DIR, "__forbidden_blocked_file__")

    def do_HEAD(self):
        target = self.translate_path(self.path)
        if "__forbidden" in target or not os.path.exists(target):
            self.send_error(403, "Access Denied: Protected Resource")
            return
        super().do_HEAD()

    def do_GET(self):
        if self.path == "/favicon.ico":
            self.send_response(204)
            self.end_headers()
            return
        target = self.translate_path(self.path)
        if "__forbidden" in target or not os.path.exists(target):
            self.send_error(403, "Access Denied: Protected Resource")
            return
        super().do_GET()

    def do_POST(self):
        if self.path in ("/api/audit-bill", "/api/analyze"):
            try:
                content_length = int(self.headers.get("Content-Length", 0))
                if content_length > 100_000:
                    self.send_error(413, "Payload Too Large")
                    return

                post_data = self.rfile.read(content_length).decode("utf-8")
                body = json.loads(post_data) if post_data else {}
                receipt_type = str(body.get("receipt_type", "KR"))
                condition = str(body.get("condition", "요추 디스크(추간판 탈출증)"))
                pain_regions = str(body.get("pain_regions", "허리, 골반"))
                vas = int(body.get("vas", 6))
                steps_drop = str(body.get("steps_drop", "-73%"))
                arousal_min = int(body.get("arousal_min", 42))

                if USE_LIVE_API and NEBIUS_API_KEY:
                    try:
                        result = call_nebius_nemotron(receipt_type, condition, pain_regions, vas, steps_drop, arousal_min)
                    except Exception as api_err:
                        print(f"[*] 실시간 API 통신 오류: {api_err}. 오프라인 시뮬레이션 모드로 전환.")
                        result = self._fallback_result(receipt_type, condition, str(api_err))
                else:
                    result = self._fallback_result(receipt_type, condition, "API 키 미설정 오프라인 모드")

                self.send_response(200)
                self.send_header("Content-Type", "application/json; charset=utf-8")
                self.send_header("Access-Control-Allow-Origin", "http://127.0.0.1:8585")
                self.end_headers()
                self.wfile.write(json.dumps(result, ensure_ascii=False).encode("utf-8"))

            except Exception as e:
                self.send_response(500)
                self.send_header("Content-Type", "application/json; charset=utf-8")
                self.end_headers()
                self.wfile.write(json.dumps({"error": str(e)}, ensure_ascii=False).encode("utf-8"))
        else:
            self.send_error(404, "Not Found")

    def _fallback_result(self, receipt_type, condition, reason):
        if receipt_type == "KR":
            return {
                "status": "fallback",
                "model": "오프라인 시뮬레이션 모드",
                "live_latency_ms": 0,
                "is_live": False,
                "audit_header": "병원 원무과 진료비 확인 질의서 초안",
                "target_item": "비급여 도수치료 (120,000원)",
                "reasoning": f"환자의 기저질환({condition})과 급성 통증(VAS) 경과 대비, 동일 일자 기본 물리치료와 비급여 도수치료의 동시 산정 타당성에 대해 원무과에 정중한 확인이 권고됩니다. (알림: {reason})",
                "inquiry_letter": f"[병원 원무과 진료비 확인 요청서 초안]\n환자 등록 기저질환: {condition}\n문의 사유: 물리치료 및 비급여 도수치료 동시 산정 사유 확인 요청\n진료 일자: 2026.10.25\n청구 항목: 비급여 치료비 120,000원에 대한 급여 기준 적용 여부 및 본인부담금 재산정 검토 요청\n* 본 서식은 환자의 병원비 소통을 돕기 위한 참고 질의서 초안입니다."
            }
        else:
            return {
                "status": "fallback",
                "model": "오프라인 시뮬레이션 모드",
                "live_latency_ms": 0,
                "is_live": False,
                "audit_header": "Hospital Billing Clarification Inquiry Draft",
                "target_item": "CPT 72148 Out-of-Network Lumbar Reading Fee ($920.00)",
                "reasoning": f"Cross-referencing patient's pre-existing {condition}, 73% mobility drop, and vital stability: Questions are formulated regarding clinical MDM documentation for Level 4 ED visit (CPT 99284) and federal No Surprises Act balance billing protections for CPT 72148 ($920). (Notice: {reason})",
                "inquiry_letter": f"[HOSPITAL BILLING INQUIRY DRAFT - Patient Billing Clarification]\nPatient Health Context: Pre-existing {condition}\nFacility: St. Jude Medical Center - Emergency Department\nTotal Bill: $3,450.00\nInquiry Items: CPT 99284 ($1,850.00) MDM Complexity & CPT 72148 ($920.00) Out-of-Network Specialist Reading\nRequest: Please provide clinical documentation for E/M complexity level, and clarify balance billing protections under the federal No Surprises Act (PL 116-260) for emergency facility imaging.\n* Notice: This is an informal negotiation draft provided for the patient's discussion with the hospital billing department."
            }


