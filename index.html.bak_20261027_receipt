    async function runNemotronAudit() {
      const loading = document.getElementById('auditLoading');
      const resultCard = document.getElementById('auditResultCard');

      loading.classList.remove('hidden');
      resultCard.classList.add('opacity-50');

      const headerElem = document.getElementById('auditBillHeader');
      const amountElem = document.getElementById('reductionAmount');
      const reasonElem = document.getElementById('reductionReason');

      try {
        const painRegionsStr = selectedChips.size > 0 ? Array.from(selectedChips).join(', ') : '허리, 골반';
        const payload = {
          receipt_type: currentSampleType,
          condition: selectedCondition,
          pain_regions: painRegionsStr,
          vas: currentVas,
          steps_drop: '-73%',
          arousal_min: 42
        };

        const response = await fetch('/api/audit-bill', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        if (response.ok) {
          const data = await response.json();
          if (data.audit_header) headerElem.textContent = data.audit_header;
          if (data.target_item) amountElem.textContent = data.target_item;
          else if (data.reduction_amount) amountElem.textContent = data.reduction_amount;
          if (data.reasoning) reasonElem.textContent = data.reasoning;
          if (data.inquiry_letter) currentDisputeLetter = data.inquiry_letter;
          else if (data.dispute_letter) currentDisputeLetter = data.dispute_letter;

          const statusBadge = document.getElementById('auditStatusBadge');
          if (statusBadge) {
            statusBadge.textContent = '생성 완료';
            statusBadge.className = 'text-[10px] px-2 py-0.5 rounded bg-cyan-950 text-cyan-300 font-bold border border-cyan-800';
          }

          const modelBadge = document.getElementById('auditModelBadge');
          const latencyBadge = document.getElementById('auditLatencyBadge');
          if (modelBadge && data.model) modelBadge.textContent = data.model;
          if (latencyBadge && data.live_latency_ms !== undefined) latencyBadge.textContent = `${data.live_latency_ms}ms (Live API)`;

          const latStr = data.live_latency_ms ? ` (${data.live_latency_ms}ms)` : '';
          showToast(`NVIDIA Nemotron 3 Ultra 550B 소명 질의서 도출 완료${latStr}`);
        } else {
          throw new Error('API server HTTP ' + response.status);
        }
      } catch (err) {
        console.warn('API call error:', err);
        headerElem.textContent = '⚠️ API 연결 실패 (서버 연결 확인 필요)';
        amountElem.textContent = '확인 불가';
        reasonElem.textContent = '서버 또는 Nebius API 호출 중 오류가 발생했습니다: ' + (err.message || '네트워크 오류');
        showToast('⚠️ 감사 실행 중 오류가 발생했습니다.');
      } finally {
        loading.classList.add('hidden');
        resultCard.classList.remove('opacity-50');
      }
    }

