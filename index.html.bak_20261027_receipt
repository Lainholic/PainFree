    function renderDoctorChart() {
      const ctx = document.getElementById('doctorTrendChart').getContext('2d');
      if (trendChartInstance) {
        trendChartInstance.destroy();
      }

      // 실제 시스템 날짜 기준 최근 7일 라벨 자동 생성
      const now = new Date();
      const labels = [];
      for (let i = 6; i >= 1; i--) {
        const d = new Date(now);
        d.setDate(d.getDate() - i);
        labels.push(`${d.getMonth() + 1}.${d.getDate()}`);
      }
      labels.push('오늘');

      // 최근 7일 통증 데이터 (실제 일지 및 오늘 VAS 동적 결합)
      let vasSeries = [3, 4, 3, 5, 5, 7, currentVas];
      let stepsSeries = [5400, 4800, 5100, 3200, 2400, 980, 1200];

      // journalData에 저장된 실제 기록이 있을 경우 역순으로 과거 일자에 매핑
      if (Array.isArray(journalData) && journalData.length > 0) {
        journalData.slice(0, 5).forEach((entry, idx) => {
          const pos = 5 - idx;
          if (pos >= 0 && typeof entry.vas === 'number') {
            vasSeries[pos] = entry.vas;
          }
        });
      }
      vasSeries[6] = currentVas;

      trendChartInstance = new Chart(ctx, {
        type: 'line',
        data: {
          labels: labels,
          datasets: [
            {
              label: '통증 강도 (VAS 0-10)',
              data: vasSeries,
              borderColor: '#ef4444',
              backgroundColor: 'rgba(239, 68, 68, 0.15)',
              tension: 0.3,
              yAxisID: 'yVas',
              borderWidth: 2,
              pointRadius: 3,
            },
            {
              label: '워치 보행수 (걸음)',
              data: stepsSeries,
              borderColor: '#0284c7',
              backgroundColor: 'rgba(2, 132, 199, 0.1)',
              tension: 0.3,
              yAxisID: 'ySteps',
              borderWidth: 2,
              pointRadius: 3,
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              display: true,
              labels: {
                boxWidth: 8,
                font: { size: 9 }
              }
            }
          },
          scales: {
            x: {
              ticks: { font: { size: 9 } },
              grid: { display: false }
            },
            yVas: {
              type: 'linear',
              position: 'left',
              min: 0,
              max: 10,
              ticks: { stepSize: 2, font: { size: 8 } }
            },
            ySteps: {
              type: 'linear',
              position: 'right',
              min: 0,
              max: 6000,
              ticks: { stepSize: 2000, font: { size: 8 } },
              grid: { display: false }
            }
          }
        }
      });
    }

