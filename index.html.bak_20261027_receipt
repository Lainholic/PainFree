    function addLaserPin(event, view) {
      const svg = view === 'front' ? document.getElementById('svgBodyFront') : document.getElementById('svgBodyBack');
      const rect = svg.getBoundingClientRect();

      // Transform client coordinates to SVG viewBox (Unified 320x618 for PainFree body.png)
      const scaleX = 320 / rect.width;
      const scaleY = 618 / rect.height;
      const x = (event.clientX - rect.left) * scaleX;
      const y = (event.clientY - rect.top) * scaleY;

      const group = view === 'front' ? document.getElementById('pinsGroupFront') : document.getElementById('pinsGroupBack');

      // Create laser pin circle element (radius 3.5px)
      const pin = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
      pin.setAttribute('cx', x.toFixed(1));
      pin.setAttribute('cy', y.toFixed(1));
      pin.setAttribute('r', '3.5');
      pin.setAttribute('class', 'laser-pin');

      // Click on pin to remove individual pin
      pin.onclick = (e) => {
        e.stopPropagation();
        group.removeChild(pin);
        if (view === 'front') {
          frontPins = frontPins.filter(p => p !== pin);
        } else {
          backPins = backPins.filter(p => p !== pin);
        }
        updateModalPinBadge();
      };

      group.appendChild(pin);
      if (view === 'front') {
        frontPins.push(pin);
      } else {
        backPins.push(pin);
      }
      updateModalPinBadge();
    }

