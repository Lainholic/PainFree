    // Delete a journal entry
    function deleteJournal(id, event) {
      if (event) event.stopPropagation();
      journalData = journalData.filter(x => x.id !== id);
      saveJournalStorage();
      loadJournalStorage();
      renderJournalList();
      showToast('선택한 기록 일지가 삭제되었습니다.');
      const detailModal = document.getElementById('recordDetailModal');
      if (detailModal && !detailModal.classList.contains('hidden')) {
        closeDetailModal();
      }
    }

    // Render Journal List UI
    function renderJournalList() {
      const container = document.getElementById('journalList');
      const countBadge = document.getElementById('journalCountBadge');
      if (countBadge) {
        countBadge.textContent = `${journalData.length}건 저장됨`;
      }
      container.innerHTML = '';

      if (journalData.length === 0) {
        container.innerHTML = `
          <div class="py-6 text-center text-slate-500 bg-slate-900/40 rounded-xl border border-dashed border-slate-800">
            <i class="fa-regular fa-folder-open text-xl mb-1.5 text-slate-600 block"></i>
            <p class="text-xs">저장된 기록 일지가 없습니다.</p>
          </div>
        `;
        return;
      }

      journalData.forEach((item) => {
        const div = document.createElement('div');
        div.className = 'p-3 rounded-xl bg-slate-900/60 border border-slate-700/50 flex items-center justify-between hover:border-slate-600 transition-all';
        div.innerHTML = `
          <div class="flex-1 pr-2">
            <div class="flex items-center space-x-2">
              <span class="text-xs font-bold text-white">${item.date}</span>
              <span class="text-[10px] px-1.5 py-0.2 rounded font-semibold ${item.vas >= 7 ? 'bg-rose-950 text-rose-300 border border-rose-800' : 'bg-amber-950 text-amber-300 border border-amber-800'}">
                VAS ${item.vas}
              </span>
            </div>
            <p class="text-[11px] text-slate-300 mt-0.5">${item.regions} · ${item.pins}</p>
          </div>
          <div class="flex items-center space-x-1.5">
            <button type="button" onclick="viewDetail(${item.id})" class="text-[11px] text-cyan-400 bg-cyan-950/80 hover:bg-cyan-900 border border-cyan-800/80 px-2 py-1 rounded-lg font-semibold transition-all">
              상세
            </button>
            <button type="button" onclick="deleteJournal(${item.id}, event)" title="기록 삭제" class="text-[11px] text-rose-400 bg-rose-950/60 hover:bg-rose-900 border border-rose-800/70 px-2 py-1 rounded-lg font-semibold transition-all flex items-center space-x-1">
              <i class="fa-regular fa-trash-can"></i>
              <span>삭제</span>
            </button>
          </div>
        `;
        container.appendChild(div);
      });
    }

    // Detail Modal
    function viewDetail(id) {
      currentDetailId = id;
      const item = journalData.find(x => x.id === id);
      if (!item) return;

      document.getElementById('detailDate').textContent = `${item.date} 상세 기록`;
      document.getElementById('detailRegions').textContent = `${item.regions} (VAS ${item.vas}/10)`;
      document.getElementById('detailPins').textContent = item.pins;
      document.getElementById('detailWatch').textContent = item.watch;
      document.getElementById('detailAudit').textContent = item.audit;

      document.getElementById('recordDetailModal').classList.remove('hidden');
    }

    function closeDetailModal() {
      document.getElementById('recordDetailModal').classList.add('hidden');
    }

    // Toast Utility
    function showToast(msg) {
      const toast = document.getElementById('toast');
      document.getElementById('toastMsg').textContent = msg;
      toast.classList.remove('opacity-0', 'pointer-events-none');
      setTimeout(() => {
        toast.classList.add('opacity-0', 'pointer-events-none');
      }, 2200);
    }

    function scrollToTop() {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
  </script>
</body>
</html>